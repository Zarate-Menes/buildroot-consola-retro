# linux.fragment
#
# Autores: Beltrán García Fernando, Vargas Luna José Ángel, Zárate Menes Quetzalli
# Fecha: 2026.11.12
# Licencia: MIT
#
# Cambios sobre bcmrpi3_defconfig del kernel de Raspberry Pi: scheduler de baja
# latencia, video y audio por HDMI integrados, controlador del gamepad Xbox 360,
# memoria USB, SquashFS y eliminación de componentes sin uso.

# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y

CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y

CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_FBDEV_EMULATION=y

CONFIG_SND=y
CONFIG_SND_SOC=y

CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
# CONFIG_JOYSTICK_XPAD_FF is not set
# CONFIG_JOYSTICK_XPAD_LEDS is not set

CONFIG_USB_STORAGE=y
CONFIG_BLK_DEV_SD=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y

# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set
# CONFIG_BT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
CONFIG_DEBUG_INFO_NONE=y

# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
CONFIG_USB_DWCOTG=y
CONFIG_I2C_BCM2835=y
# CONFIG_FB_SIMPLE is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_BLK_DEV_LOOP is not set

# CONFIG_RANDOMIZE_BASE is not set

# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_ISCSI_TCP is not set
# CONFIG_SCSI_ISCSI_ATTRS is not set
# CONFIG_AUDIT is not set
# CONFIG_SND_BCM2835 is not set
